{
  "name": "weather_dashboard",
  "version": "1.0.0",
  "description": "High-performance, real-time weather forecast application built with Vanilla JavaScript (ES6+), semantic HTML5, and CSS3 Glassmorphism, powered by the Open-Meteo REST API.",
  "main": "script.js",
  "scripts": {
    "test": "vitest run && playwright test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "weather",
    "open-meteo",
    "vanilla-javascript",
    "glassmorphism",
    "vitest",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
